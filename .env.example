# Variables de entorno de App Encuentra.
# Copia este archivo como .env.local y completá los valores.
# NUNCA subas .env.local al repositorio: contiene claves reales.

# ── Supabase ──────────────────────────────────────────────
# La URL y la clave anónima son públicas (viajan al navegador).
# La service role IGNORA las reglas de seguridad de la base:
# solo puede usarse en código de servidor, nunca en el cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Aplicación ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.appencuentra.com

# ── Pagos ─────────────────────────────────────────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id del webhook creado en el panel de PayPal (Apps & Credentials → tu app →
# Webhooks). Sin él, /api/memberships/paypal/webhook rechaza todo evento: un
# endpoint que aplica membresías sin comprobar la firma las regala a cualquiera
# que sepa la URL. Ver docs/INTEGRACION_PAYPAL_COMPLETA.md.
PAYPAL_WEBHOOK_ID=
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=

# ── Correo (Resend) ───────────────────────────────────────
# El dominio debe estar verificado en Resend (registros SPF y DKIM en el DNS)
# para poder enviar desde una dirección propia. Sin verificar, solo se puede
# usar el remitente de pruebas, que únicamente entrega al dueño de la cuenta.
RESEND_API_KEY=
RESEND_FROM_EMAIL=contacto@appencuentra.com
RESEND_FROM_NAME=App Encuentra

# ── Acceso administrativo ─────────────────────────────────
# Protegen el panel interno. Usá valores largos y únicos.
ADMIN_MASTER_PIN=
ADMIN_PANEL_PASSWORD=
ADMIN_SETUP_KEY=

# ── Monitoreo de errores (Sentry) ─────────────────────────
# Sin DSN el SDK queda inerte: la app funciona igual y no manda nada. Se
# enciende pegando aquí el DSN del proyecto de Sentry.
NEXT_PUBLIC_SENTRY_DSN=

# Sólo para el build: suben los mapas de código para que un informe diga
# archivo y línea de TU código en vez de "chunk-4f2a.js:1:28470". Sin ellas el
# build funciona, pero los informes llegan ilegibles.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Otras detectadas ──────────────────────────────────────
VERCEL_OIDC_TOKEN=
