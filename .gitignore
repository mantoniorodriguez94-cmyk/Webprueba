# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# supabase CLI local cache
supabase/.temp

# local dev tooling config.
# Se ignora el CONTENIDO de .claude y no la carpeta: git no reincorpora nada
# que esté dentro de un directorio ya excluido, así que con `.claude` a secas
# la excepción de abajo no tendría efecto.
.claude/*

# Las habilidades sí se versionan: no son configuración local sino
# conocimiento del proyecto, y deben viajar con el código que auditan.
!.claude/skills/

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA files
**/public/sw.js
**/public/workbox-*.js
**/public/worker-*.js
**/public/sw.js.map
**/public/workbox-*.js.map
**/public/worker-*.js.map


# Instantánea vieja del código. git ya es el respaldo, y con historial.
src.zip
*.zip
